{
    "name": "stack-overflow-backend",
    "version": "1.0.0",
    "description": "A mock backend for Stack Overflow like messaging board created as a part of Swiggy i++",
    "main": "./lib/index.js",
    "scripts": {
        "build": "babel src -d lib",
        "start": "npm run build & node ./lib/index.js",
        "test": "jest",
        "watch": "nodemon --watch src --exec npm run start"
    },
    "keywords": [
        "nodejs",
        "express",
        "REST",
        "swiggy",
        "swiggy-ipp",
        "npm"
    ],
    "author": "dhi13man",
    "license": "MIT",
    "devDependencies": {
        "@babel/cli": "^7.16.7",
        "@babel/core": "^7.16.7",
        "@babel/plugin-proposal-class-properties": "^7.18.6",
        "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
        "@babel/preset-env": "^7.16.7",
        "babel-jest": "^27.4.6",
        "eslint": "^8.6.0",
        "eslint-config-google": "^0.14.0",
        "jest": "^27.4.7",
        "nodemon": "^2.0.15"
    },
    "dependencies": {
        "bcrypt": "^5.0.1",
        "body-parser": "^1.20.3",
        "cookie-parser": "^1.4.6",
        "dotenv": "^10.0.0",
        "express": "^4.19.2",
        "jsonwebtoken": "^9.0.0",
        "morgan": "^1.11.0"
    },
    "jest": {
        "transform": {
            "^.+\\.[t|j]sx?$": "babel-jest"
        },
        "maxWorkers": 1
    },
    "overrides": {
        "@babel/plugin-transform-modules-systemjs": "7.29.4",
        "@babel/traverse": "7.29.8",
        "brace-expansion": "1.1.18",
        "brace-expansion@^1": "1.1.18",
        "braces": "3.0.3",
        "browserslist": "4.28.7",
        "flatted": "3.4.2",
        "form-data": "3.0.5",
        "got": "11.8.5",
        "js-yaml@^3": "3.15.2",
        "js-yaml@^4": "4.3.2",
        "json5": "2.2.2",
        "jws": "3.2.3",
        "lodash": "4.18.1",
        "minimatch": "3.1.4",
        "minimist": "1.2.6",
        "node-fetch": "2.6.7",
        "path-to-regexp": "0.1.13",
        "picomatch": "2.3.2",
        "qs@~6.9": "6.9.7",
        "qs": "6.16.0",
        "semver@^5": "5.7.2",
        "semver@^6": "6.3.1",
        "semver@^7": "7.5.2",
        "tar": "7.5.21",
        "tough-cookie": "4.1.3",
        "ws": "7.5.11"
    }
}
